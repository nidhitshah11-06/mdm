# SME-Twin Environment Configuration Example
# Copy this file to .env and fill in your private credentials.
# DO NOT commit .env to any public Git repository.

APP_NAME=SME-Twin
ENVIRONMENT=development

# Database Connection (Supabase / PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:5432/<database>
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@your_supabase_host.supabase.co:5432/postgres

# Allowed CORS Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5500","http://localhost:5500"]

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Twilio Credentials for Alerts & WhatsApp Notifications
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optimization & System Thresholds
MAX_UPLOAD_BYTES=10485760
PEAK_DEMAND_POWER_FACTOR=0.9
